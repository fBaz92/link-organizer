# ── Configurazione del servizio (wizard HomeGate o .env manuale) ──
# Il wizard di HomeGate genera questi campi e scrive il .env in
# /etc/homegate/services/link-organizer/.env. HOMEGATE_STATE_DIR e
# HOMEGATE_CONFIG_DIR sono iniettate dal sistema: non vanno impostate a mano.

# Token del bot da @BotFather (mai scrivere credenziali reali nel repo)
BOT_TOKEN=
# ID Telegram autorizzati, separati da virgola (solo questi utenti possono usare il bot)
TELEGRAM_ALLOWED_USER_IDS=
# Password di accesso alla pagina web
WEB_PASSWORD=

# ── Parametri operativi ──

# Nel container Docker la webapp Next ascolta sulla porta interna 3000
# (fissa nel manifest); quella pubblica è il proxy HomeGate (proxy_port).
# In sviluppo locale il visualizzatore del processo servizio usa invece:
# PORT=8787

# URL pubblico della webapp, usato dal bot per i deep link
# (Docker: es. http://IP-DEL-GATEWAY:8790 — default stimato dalla rete)
# WEB_APP_URL=http://192.168.1.10:8790

# Chat Telegram che riceve i video scaricati dalla web UI
# (default: il primo ID autorizzato)
# TELEGRAM_UPLOAD_CHAT_ID=

# Percorso di yt-dlp: nel container è già incluso; serve solo per
# puntare a un binario diverso (in sviluppo: brew install yt-dlp + ffmpeg)
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp

# ── Solo sviluppo locale (fuori da HomeGate) ──

# Cartella dati (SQLite, file, thumbnail). In HomeGate vince HOMEGATE_STATE_DIR.
# DATA_DIR=./data

# ── Tag semantici (script CLI di sviluppo: pnpm auto-tag) ──
# Modello di embedding locale: ~120 MB al primo uso, poi cache nel data dir.
# SEMANTIC_TAGS=0          # disattiva (restano le regole keyword)
# SEMANTIC_TAGS_THRESHOLD=0.83  # similarità minima (default calibrato su e5)
# SEMANTIC_TAGS_TOP_K=5    # massimo tag semantici per item
# SEMANTIC_TAGS_MODEL=Xenova/multilingual-e5-small
